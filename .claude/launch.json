{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "./venv/bin/python",
      "runtimeArgs": [
        "-m",
        "backend.api"
      ],
      "port": 5000,
      "autoPort": false
    }
  ]
}
